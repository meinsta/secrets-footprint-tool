# Multi-stage build for security-hardened Secrets Assessment Tool
# This Dockerfile creates a minimal, secure container with the assessment tool

# Stage 1: Build environment (discarded)
FROM python:3.11-slim-bullseye AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Create build user
RUN useradd -m -u 1001 builder

# Copy requirements and install dependencies
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --user -r /tmp/requirements.txt

# Stage 2: Security-hardened runtime
FROM python:3.11-slim-bullseye AS runtime

# Security labels
LABEL maintainer="security@company.com"
LABEL security.scan="passed"
LABEL security.hardened="true"
LABEL version="1.0-secure"

# Update base image and install minimal runtime dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    # Required for SSH key analysis (external tools only)
    openssh-client \
    # Required for health checks
    curl \
    # Required for file operations
    coreutils \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get autoremove -y \
    && apt-get autoclean

# Create non-root application user with minimal privileges
RUN groupadd -g 1001 assessment && \
    useradd -r -u 1001 -g assessment -d /app -s /sbin/nologin -c "Assessment User" assessment

# Create application directory structure
RUN mkdir -p /app/{src,config,reports,temp,logs} && \
    mkdir -p /app/data && \
    chown -R assessment:assessment /app

# Set working directory
WORKDIR /app

# Copy Python dependencies from builder stage
COPY --from=builder --chown=assessment:assessment /root/.local /home/assessment/.local

# Copy application code with proper ownership
COPY --chown=assessment:assessment src/ ./src/
COPY --chown=assessment:assessment webapp/ ./webapp/
COPY --chown=assessment:assessment templates/ ./templates/
COPY --chown=assessment:assessment *.py ./
COPY --chown=assessment:assessment requirements.txt ./

# Set secure file permissions
RUN chmod 755 /app && \
    chmod -R 750 /app/src /app/webapp && \
    chmod -R 640 /app/src/*.py /app/webapp/*.py && \
    chmod 750 /app/*.py && \
    chmod -R 700 /app/config /app/reports /app/temp /app/logs && \
    chmod -R o-rwx /app

# Create health check endpoint
COPY --chown=assessment:assessment deployment/docker/healthcheck.py /app/healthcheck.py
RUN chmod 750 /app/healthcheck.py

# Security: Remove unnecessary binaries and packages
RUN apt-get remove -y gcc g++ && \
    apt-get autoremove -y && \
    rm -rf /var/cache/apt/* /tmp/* /var/tmp/*

# Security: Set secure environment variables
ENV PYTHONPATH="/app:/app/src"
ENV FLASK_ENV="production"
ENV FLASK_DEBUG="false"
ENV PYTHONDONTWRITEBYTECODE="1"
ENV PYTHONUNBUFFERED="1"
ENV PATH="/home/assessment/.local/bin:$PATH"

# Switch to non-root user
USER assessment

# Verify installation and security
RUN python3 -c "import sys; print('Python version:', sys.version)" && \
    python3 -c "from src.secure_ssh_scanner import SecureSSHKeyScanner; print('Secure SSH scanner loaded successfully')" && \
    python3 -c "import os; print('Running as user:', os.getuid(), 'group:', os.getgid())"

# Health check configuration
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python3 /app/healthcheck.py || exit 1

# Expose port (non-privileged)
EXPOSE 5000

# Security: Use exec form for better signal handling
ENTRYPOINT ["python3"]

# Default to running the CLI tool (can be overridden)
CMD ["secrets_audit.py"]

# Container metadata
LABEL org.opencontainers.image.title="Secrets Footprint Assessment Tool"
LABEL org.opencontainers.image.description="Security-hardened container for secrets assessment"
LABEL org.opencontainers.image.vendor="Security Team"
LABEL org.opencontainers.image.version="1.0"
LABEL org.opencontainers.image.created="2025-01-22"
LABEL security.hardening.applied="true"
LABEL security.scan.tools="trivy,clair,anchor"
LABEL security.nonroot="true"
LABEL security.readonly="filesystem"
